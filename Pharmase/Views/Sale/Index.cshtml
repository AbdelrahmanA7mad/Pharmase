@model Pharmase.ViewModels.SaleIndexViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Sales List";
}

<div class="dashboard">
    <div class="page-header">
        <h1 data-translate ="Sales">Sales</h1>
        <a class="btn-primary text-decoration-none" data-translate="new_sale" asp-action="Create">New Sale</a>
    </div>

    <div class="stats-container">
        <div class="stat-card">
            <i class="fas fa-chart-line"></i>
            <div class="stat-info">
                <h3 data-translate="today_sales">Today's Sales</h3>
                <p>@Model.TodaySales.ToString("C")</p>
            </div>
        </div>
        <div class="stat-card">
            <i class="fas fa-shopping-cart"></i>
            <div class="stat-info">
                <h3 data-translate="total_orders">Total Orders</h3>
                <p>@Model.TotalOrders</p>
            </div>
        </div>
    </div>

    <div class="content-section">
        <h2 data-translate="RecentSales">Recent Sales</h2>
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th data-translate="items">Items</th>
                        <th data-translate="amount">Amount</th>
                        <th data-translate="date">Date</th>
                        <th data-translate="actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Sales.Any())
                    {
                        foreach (var sale in Model.Sales)
                        {
                            <tr>
                                <td>@sale.SaleItems.Count</td>
                                <td>@sale.TotalPrice.ToString("C")</td>
                                <td>@sale.SaleDate.ToString("yyyy-MM-dd")</td>
                                <td class="actions">
                                    <a href="@Url.Action("Details", new { id = sale.Id })" class="btn-icon">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">No sales records found</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>