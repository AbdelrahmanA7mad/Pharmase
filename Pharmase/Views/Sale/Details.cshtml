@model Pharmase.Models.Sale
@{
    ViewData["Title"] = "Sale Details";
}

<div class="details-container">
    <div class="page-header">
        <h1>Sale Details</h1>
        <a asp-action="Index" class="btn btn-back">Back to List</a>
    </div>

    <div class="sale-info">
        <div class="info-item">
            <label>Sale ID:</label>
            <span>@Model.Id</span>
        </div>
        <div class="info-item">
            <label>Sale Date:</label>
            <span>@Model.SaleDate.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
        <div class="info-item">
            <label>Total Amount:</label>
            <span>@Model.TotalPrice.ToString("C")</span>
        </div>
    </div>

    <h3>Items Sold</h3>
    <div class="table-container">
        <table class="items-table">
            <thead>
                <tr>
                    <th>Medicine</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.SaleItems)
                {
                    <tr>
                        <td>@item.Medicine?.Name</td>
                        <td>@item.QuantitySold</td>
                        <td>@item.Price.ToString("C")</td>
                        <td>@((item.QuantitySold * item.Price).ToString("C"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .details-container {
        max-width: 1000px;
        margin: 20px auto;
        padding: 20px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .sale-info {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 5px;
        margin-bottom: 30px;
    }

    .info-item {
        display: flex;
        margin-bottom: 10px;
    }

    .info-item label {
        font-weight: 600;
        width: 150px;
    }

    .items-table {
        width: 100%;
        border-collapse: collapse;
    }

    .items-table th,
    .items-table td {
        padding: 12px;
        text-align: left;
        border-bottom: 1px solid #dee2e6;
    }

    .items-table th {
        background-color: #f8f9fa;
    }

    .btn-back {
        background-color: #6c757d;
        color: white;
        padding: 8px 16px;
        text-decoration: none;
        border-radius: 4px;
    }

    .btn-back:hover {
        background-color: #5a6268;
    }
</style>